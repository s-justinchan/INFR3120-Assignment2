<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/Content/app.css' />
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css"/>
    <script src="/bootstrap/dist/js/bootstrap.min.js"></script>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">INFR3120</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <% if (title == "Home") {%>
                <a class="nav-link active" aria-current="page" href="/home"><i class="fa-solid fa-house fa-lg"></i> Home</a>
                <% } else {%>
                <a class="nav-link" aria-current="page" href="/home"><i class="fa-solid fa-house"></i> Home</a>
                <% } %>
              </li>
              <li class="nav-item">
                <% if (title == "About Us") {%>
                <a class="nav-link active" aria-current="page" href="/aboutus"><i class="fa-solid fa-circle-info fa-lg"></i> About Us</a>
                <% } else {%>
                <a class="nav-link" aria-current="page" href="/aboutus"><i class="fa-solid fa-circle-info"></i> About Us</a>
                <% } %>
              </li>
              <li class="nav-item">
                <% if (title == "Contact Us") {%>
                <a class="nav-link active" aria-current="page" href="/contact"><i class="fa-solid fa-envelope fa-lg"></i> Contact</a>
                <% } else {%>
                <a class="nav-link" aria-current="page" href="/contact"><i class="fa-solid fa-envelope"></i> Contact</a>
                <% } %>
              </li>
              <li class="nav-item">
                <% if (title == "Products") {%>
                <a class="nav-link active" aria-current="page" href="/products"><i class="fa-solid fa-screwdriver-wrench fa-lg"></i> Products</a>
                <% } else {%>
                <a class="nav-link" aria-current="page" href="/products"><i class="fa-solid fa-screwdriver-wrench"></i> Products</a>
                <% } %>
              </li>
              <li class="nav-item">
                <% if (title == "Services") {%>
                <a class="nav-link active" aria-current="page" href="/services"><i class="fa-solid fa-user-gear fa-lg"></i> Services</a>
                <% } else {%>
                <a class="nav-link" aria-current="page" href="/services"><i class="fa-solid fa-user-gear"></i> Services</a>
                <% } %>
              </li>
          </div>
      </div>
    </nav>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
  </body>
  <script src="/Script/app.js"></script>
</html>
